#!/usr/bin/env python3
"""vhs-cap DEVICE WIDTH HEIGHT [PREVIEW_FD]  ->  raw UYVY frames on stdout

Captures from a V4L2 device with mmap buffers, like ffmpeg does, but keeps the
frames ffmpeg throws away.  When the STK1160 loses sync on a rough tape it
completes a buffer with only one field written, or a few lines short.  Every
buffer is zeroed before it is queued, so afterwards any line that is still all
zero never arrived and is filled from the nearest line that did.  The frame
comes out softer for one frame time instead of missing, so playback stays smooth.

Frames go out on a steady grid (25 fps for 576 lines, 29.97 for 480) placed by the
card's own capture timestamps, not by when anyone reads them: a frame the card missed
is filled by repeating the previous one, so the stream stays in step with the audio
and a slow reader can never cause frames to be thrown away later on. 32 driver buffers
let the card ride out ~1.3 s of downstream stall. An optional PREVIEW_FD gets a copy of
the frames without ever blocking: when the preview is slow it simply skips frames.

Set the input and video standard with v4l2-ctl before starting this.
VHS_DEBUG=1 prints a histogram of buffer sizes at exit.
"""
import ctypes, fcntl, mmap, os, select, sys, time

IDLE_TIMEOUT = float(os.environ.get("VHS_IDLE_TIMEOUT", "15"))
if IDLE_TIMEOUT <= 0:
    raise ValueError("VHS_IDLE_TIMEOUT must be positive")

dev, width, height = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
preview_fd = int(sys.argv[4]) if len(sys.argv) > 4 else None
PERIOD = 1001 / 30000 if height == 480 else 1 / 25   # seconds per frame
LINE = width * 2                      # UYVY is 2 bytes per pixel
FRAME = LINE * height
NBUF = 32
ZERO_LINE, ZERO_FRAME = bytes(LINE), bytes(FRAME)
DEBUG = os.environ.get("VHS_DEBUG")

# --- just enough of <linux/videodev2.h> --------------------------------------
class Timeval(ctypes.Structure):
    _fields_ = [("sec", ctypes.c_long), ("usec", ctypes.c_long)]

class Timecode(ctypes.Structure):
    _fields_ = [("type", ctypes.c_uint32), ("flags", ctypes.c_uint32),
                ("frames", ctypes.c_uint8), ("seconds", ctypes.c_uint8),
                ("minutes", ctypes.c_uint8), ("hours", ctypes.c_uint8),
                ("userbits", ctypes.c_uint8 * 4)]

class Mem(ctypes.Union):
    _fields_ = [("offset", ctypes.c_uint32), ("userptr", ctypes.c_ulong),
                ("planes", ctypes.c_void_p), ("fd", ctypes.c_int32)]

class Buffer(ctypes.Structure):
    _fields_ = [("index", ctypes.c_uint32), ("type", ctypes.c_uint32),
                ("bytesused", ctypes.c_uint32), ("flags", ctypes.c_uint32),
                ("field", ctypes.c_uint32), ("timestamp", Timeval),
                ("timecode", Timecode), ("sequence", ctypes.c_uint32),
                ("memory", ctypes.c_uint32), ("m", Mem),
                ("length", ctypes.c_uint32), ("reserved2", ctypes.c_uint32),
                ("request_fd", ctypes.c_int32)]

class RequestBuffers(ctypes.Structure):
    _fields_ = [("count", ctypes.c_uint32), ("type", ctypes.c_uint32),
                ("memory", ctypes.c_uint32), ("capabilities", ctypes.c_uint32),
                ("flags", ctypes.c_uint8), ("reserved", ctypes.c_uint8 * 3)]

assert ctypes.sizeof(Buffer) == 88 and ctypes.sizeof(RequestBuffers) == 20

def ioc(direction, nr, size):
    return (direction << 30) | (size << 16) | (ord("V") << 8) | nr

VIDIOC_REQBUFS, VIDIOC_QUERYBUF = ioc(3, 8, 20), ioc(3, 9, 88)
VIDIOC_QBUF, VIDIOC_DQBUF = ioc(3, 15, 88), ioc(3, 17, 88)
VIDIOC_STREAMON, VIDIOC_STREAMOFF = ioc(1, 18, 4), ioc(1, 19, 4)
CAPTURE, MMAP, FLAG_ERROR = 1, 1, 0x40
# ------------------------------------------------------------------------------

def write_all(view):
    while view:
        view = view[os.write(1, view):]

preview_left = None      # part of a frame still to be written to the preview
def preview(frame):
    """Best-effort copy for the live window: never waits, skips frames it has no room for."""
    global preview_fd, preview_left
    if preview_fd is None:
        return
    try:
        if preview_left is None:
            preview_left = memoryview(frame)
        elif frame is not None:
            pass                                    # still busy with the previous frame: skip this one
        while preview_left:
            preview_left = preview_left[os.write(preview_fd, preview_left):]
        preview_left = None
    except BlockingIOError:
        pass                                        # pipe full: finish this frame later
    except (BrokenPipeError, OSError):
        preview_fd = None                           # window closed: carry on without it

if preview_fd is not None:
    os.set_blocking(preview_fd, False)
    try:
        fcntl.fcntl(preview_fd, 1031, 1 << 20)      # F_SETPIPE_SZ: room for a whole frame
    except OSError:
        pass

def repair(buf):
    """Fill lines that never arrived (still zero) from the nearest line that did."""
    present = [buf[r * LINE:(r + 1) * LINE] != ZERO_LINE for r in range(height)]
    valid = [r for r, exists in enumerate(present) if exists]
    if not valid:
        return height
    nearest = 0
    for r in range(height):
        if present[r]:
            continue
        while nearest + 1 < len(valid) and abs(valid[nearest + 1] - r) < abs(valid[nearest] - r):
            nearest += 1
        src = valid[nearest]
        buf[r * LINE:(r + 1) * LINE] = buf[src * LINE:(src + 1) * LINE]
    return height - sum(present)

fd = os.open(dev, os.O_RDWR)
req = RequestBuffers(count=NBUF, type=CAPTURE, memory=MMAP)
fcntl.ioctl(fd, VIDIOC_REQBUFS, req)
bufs = []
for i in range(req.count):
    b = Buffer(index=i, type=CAPTURE, memory=MMAP)
    fcntl.ioctl(fd, VIDIOC_QUERYBUF, b)
    assert b.length >= FRAME, f"buffer is {b.length} bytes, frame needs {FRAME}"
    m = mmap.mmap(fd, b.length, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE, offset=b.m.offset)
    m[:FRAME] = ZERO_FRAME
    bufs.append(m)
    fcntl.ioctl(fd, VIDIOC_QBUF, b)
fcntl.ioctl(fd, VIDIOC_STREAMON, ctypes.c_int(CAPTURE))

frames = repaired = repeated = dropped = 0
t0, next_slot, last = None, 0, None                   # the steady output grid
sizes, gaps, max_gap, last_ts = {}, 0, 0.0, None      # debug statistics
b = Buffer(type=CAPTURE, memory=MMAP)
try:
    quiet_since = time.monotonic()
    last_warning = quiet_since - 15
    while True:
        while not select.select([fd], [], [], 3.0)[0]:          # no frame for 3 s: say so instead of blocking silently
            now = time.monotonic()
            if now - quiet_since >= IDLE_TIMEOUT:
                raise RuntimeError(f"no video frames for {IDLE_TIMEOUT:g} seconds; stopping capture")
            if now - last_warning >= 15:
                print("vhs-cap: no video frames from the card - is the VCR playing?", file=sys.stderr)
                last_warning = now
        quiet_since = time.monotonic()
        fcntl.ioctl(fd, VIDIOC_DQBUF, b)
        m = bufs[b.index]
        if DEBUG:
            sizes[b.bytesused] = sizes.get(b.bytesused, 0) + 1
            ts = b.timestamp.sec + b.timestamp.usec / 1e6
            if last_ts is not None:
                max_gap = max(max_gap, ts - last_ts)
                gaps += ts - last_ts > 0.06
            last_ts = ts
        ts = b.timestamp.sec + b.timestamp.usec / 1e6
        if b.bytesused and not b.flags & FLAG_ERROR:
            if b.bytesused < FRAME:
                if DEBUG and not repaired:
                    open("/tmp/vhs-partial-before.uyvy", "wb").write(m[:FRAME])
                missing = repair(m)
                if DEBUG and not repaired:
                    open("/tmp/vhs-partial-after.uyvy", "wb").write(m[:FRAME])
                    print(f"vhs-cap: first partial buffer had {b.bytesused} bytes, {missing} lines missing", file=sys.stderr)
                repaired += 1
            if t0 is None:
                t0 = ts
            lag = (ts - t0) / PERIOD - next_slot            # in frames; 0 = right on time
            if lag < -0.75:                                  # a second frame in the same slot
                dropped += 1
            else:
                while lag >= 0.75 and last is not None:      # the card missed frames: repeat the last one
                    write_all(memoryview(last)); repeated += 1; next_slot += 1; lag -= 1
                last = bytes(m[:FRAME])
                write_all(memoryview(last)); next_slot += 1
                frames += 1
                preview(last)
        m[:FRAME] = ZERO_FRAME
        fcntl.ioctl(fd, VIDIOC_QBUF, b)
except (KeyboardInterrupt, BrokenPipeError):      # Ctrl-C, or the recorder stopped reading
    pass
finally:
    try:
        fcntl.ioctl(fd, VIDIOC_STREAMOFF, ctypes.c_int(CAPTURE))
    except OSError:
        pass
    print(f"vhs-cap: {frames} frames, {repaired} repaired from a single field, "
          f"{repeated} repeated to fill gaps, {dropped} dropped as duplicates", file=sys.stderr)
    if DEBUG:
        print(f"vhs-cap debug: bytes-per-buffer histogram {sorted(sizes.items())}; "
              f"driver timestamp gaps >60 ms: {gaps}, largest {max_gap * 1000:.0f} ms", file=sys.stderr)
